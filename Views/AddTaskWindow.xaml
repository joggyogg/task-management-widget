<Window x:Class="TaskManagementWidget.Views.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Task"
        MinWidth="300"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#89B4FA"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#45475A"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#89B4FA"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="8,6"/>
            <Setter Property="CaretBrush"    Value="#CDD6F4"/>
            <Setter Property="SelectionBrush" Value="#4489B4FA"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground"   Value="#80FFFFFF"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#89B4FA"/>
            <Setter Property="Foreground"   Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="16,7"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4D0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="16,7"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#F38BA8"/>
            <Setter Property="BorderBrush"  Value="#F38BA8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="16,7"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="36" Height="20" CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <Ellipse Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#89B4FA"/>
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#CCFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="8,5"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="0">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#80FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#313244"
                                        BorderBrush="#50FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#CCFFFFFF"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2A89B4FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource WidgetFrameBrush}"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <StackPanel>

        <!-- Title bar / drag handle -->
        <Grid x:Name="TitleBar" Margin="16,14,12,0"
              MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0"
                       Text="New Task"
                       Foreground="#80FFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="✕"
                    Style="{StaticResource GhostButton}"
                    Padding="8,4"
                    Click="CancelBtn_Click"/>
        </Grid>

        <Rectangle Height="1" Fill="#30FFFFFF" Margin="16,10,16,0"/>

        <StackPanel Margin="16,12,16,16">
        <!-- Name (required) -->
        <Label Content="Task name *"/>
        <Border Background="#1AFFFFFF" CornerRadius="8">
            <TextBox x:Name="NameBox"
                     TextChanged="NameBox_TextChanged"/>
        </Border>

        <Label Content="Importance (1 = low, 100 = high) *" Margin="0,12,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="ImportanceSlider"
                    Grid.Column="0"
                    Minimum="1" Maximum="100" Value="50"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="ImportanceSlider_ValueChanged"/>
            <TextBlock x:Name="ImportanceLabel"
                       Grid.Column="1"
                       Text="50"
                       Foreground="#89B4FA"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Description (optional) -->
        <Label Content="Description (optional)" Margin="0,12,0,0"/>
        <Border Background="#1AFFFFFF" CornerRadius="8" Height="80">
            <TextBox x:Name="DescriptionBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Hidden"
                     VerticalAlignment="Top"/>
        </Border>

        <!-- URL (optional) -->
        <Label Content="URL (optional)" Margin="0,12,0,0"/>
        <Border Background="#1AFFFFFF" CornerRadius="8">
            <TextBox x:Name="UrlBox"/>
        </Border>

        <!-- Deadline -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="DEADLINE"
                       Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="DeadlineEnabledBox" Grid.Column="1"
                      Style="{StaticResource ToggleCheck}"
                      Checked="DeadlineEnabledBox_Changed"
                      Unchecked="DeadlineEnabledBox_Changed"/>
        </Grid>

        <StackPanel x:Name="DeadlinePanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <!-- Date: inline label + calendar button -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DateInlineLabel"
                               Grid.Column="0"
                               Text="Date"
                               Foreground="#80FFFFFF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="DatePickerBtn"
                            Grid.Column="1"
                            Content="📅"
                            Style="{StaticResource GhostButton}"
                            Padding="6,4"
                            Click="DatePickerBtn_Click"/>
                </Grid>
                <!-- Hour dropdown -->
                <StackPanel Grid.Column="2">
                    <Label Content="Hour"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8">
                        <ComboBox x:Name="DeadlineTimeCombo"
                                  Style="{StaticResource DarkComboBox}"/>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- Calendar popup -->
            <Popup x:Name="DatePopup"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="#313244"
                        BorderBrush="#50FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                    <Calendar x:Name="DeadlineCal"
                              SelectionMode="SingleDate"
                              SelectedDatesChanged="DeadlineCal_SelectedDatesChanged"/>
                </Border>
            </Popup>
        </StackPanel>

        <!-- Importance Scaling -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="IMPORTANCE SCALING"
                       Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <CheckBox x:Name="TickerEnabledBox" Grid.Column="1"
                      Style="{StaticResource ToggleCheck}"
                      Checked="TickerEnabledBox_Changed"
                      Unchecked="TickerEnabledBox_Changed"/>
        </Grid>

        <StackPanel x:Name="TickerPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="Points per tick"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8">
                        <TextBox x:Name="TickerPointsBox" Text="1"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Hours per tick"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8">
                        <TextBox x:Name="TickerHoursBox" Text="1"/>
                    </Border>
                </StackPanel>
            </Grid>
            <Button x:Name="AutoScaleBtn"
                    Content="Auto from deadline"
                    Style="{StaticResource GhostButton}"
                    Padding="0,5"
                    Margin="0,8,0,0"
                    Foreground="#89B4FA"
                    HorizontalAlignment="Left"
                    Click="AutoScaleBtn_Click"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Delete (only in edit mode) -->
            <Button x:Name="DeleteBtn"
                    Grid.Column="0"
                    Content="Delete Task"
                    Style="{StaticResource DangerButton}"
                    Visibility="Collapsed"
                    Click="DeleteBtn_Click"/>
            <!-- Cancel + Save -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        Style="{StaticResource GhostButton}"
                        Click="CancelBtn_Click"/>
                <Button x:Name="SaveBtn"
                        Content="Add Task"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Margin="8,0,0,0"
                        Click="SaveBtn_Click"/>
            </StackPanel>
        </Grid>
        </StackPanel>
        </StackPanel>
    </Border>
</Window>
