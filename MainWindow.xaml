<Window x:Class="TaskManagementWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TaskManagementWidget.Controls"
        Title="TaskWidget"
        Width="336"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,4,0,4"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource WidgetFrameBrush}"/>
            <Setter Property="Foreground"      Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="FontWeight"      Value="Light"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapseBtn" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="Foreground"          Value="#80FFFFFF"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root: tab column (36px) + main frame column (300px) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Drag-preview ghost popup: follows cursor, shown while dragging -->
        <Popup x:Name="GhostPopup"
               Placement="RelativePoint"
               AllowsTransparency="True"
               IsOpen="False"
               IsHitTestVisible="False">
            <Border CornerRadius="10"
                    Background="#E01E1E2E"
                    BorderBrush="#6064E0F6"
                    BorderThickness="1"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="GhostBadge"
                            Width="30" Height="30"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="GhostImportanceText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1E1E2E"/>
                    </Border>
                    <TextBlock x:Name="GhostNameText"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0" MaxWidth="170"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Add tab — sticks out to the left of the main frame -->
        <Button Grid.Column="0"
                Content="+"
                Style="{StaticResource TabBtn}"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Click="AddTaskBtn_Click"/>

        <!-- Main rounded frame -->
        <Border Grid.Column="1"
                CornerRadius="24"
                Background="{DynamicResource WidgetFrameBrush}"
                Padding="0,12,0,12">
            <ScrollViewer x:Name="MainScroll"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,4,8,4">

                    <StackPanel x:Name="DoingSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Doing" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="DoingList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      DragOver="List_DragOver"
                                      Drop="List_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"
                                                   AllowDrop="True"
                                                   DragOver="Card_DragOver"
                                                   DragLeave="Card_DragLeave"
                                                   Drop="Card_Drop"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="OverdueSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#60E05A57" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Overdue" Foreground="#E05A57" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#60E05A57" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="OverdueList"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="TodoSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="To Do" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="TodoList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      DragOver="List_DragOver"
                                      Drop="List_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"
                                                   AllowDrop="True"
                                                   DragOver="Card_DragOver"
                                                   DragLeave="Card_DragLeave"
                                                   Drop="Card_Drop"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="DoneSection">
                        <Button x:Name="DoneToggleBtn"
                                Style="{StaticResource CollapseBtn}"
                                Click="DoneToggleBtn_Click">
                            <TextBlock>
                                <Run x:Name="DoneChevron" Text="&#x25BE; "/>
                                <Run Text="Completed"/>
                            </TextBlock>
                        </Button>
                        <ItemsControl x:Name="DoneList" x:FieldModifier="private">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
