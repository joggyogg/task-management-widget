<Window x:Class="TaskManagementWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TaskManagementWidget.Controls"
        Title="TaskWidget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,4,0,4"/>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource WidgetFrameBrush}"/>
            <Setter Property="Foreground"      Value="#80FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="20"/>
            <Setter Property="FontWeight"      Value="Light"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CollapseBtn" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="Foreground"          Value="#80FFFFFF"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root: tab column (Auto) + main frame column (300px) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Drag-preview ghost popup: follows cursor, shown while dragging -->
        <Popup x:Name="GhostPopup"
               Placement="RelativePoint"
               AllowsTransparency="True"
               IsOpen="False"
               IsHitTestVisible="False">
            <Border CornerRadius="10"
                    Background="#E01E1E2E"
                    BorderBrush="#6064E0F6"
                    BorderThickness="1"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="GhostBadge"
                            Width="30" Height="30"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="GhostImportanceText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1E1E2E"/>
                    </Border>
                    <TextBlock x:Name="GhostNameText"
                               Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0" MaxWidth="170"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Inline task form: lives in col 0, window expands leftward when visible -->
        <Border x:Name="TaskFormPanel"
                Grid.Column="0"
                Width="290"
                Margin="0,12,8,12"
                CornerRadius="20"
                Background="{DynamicResource WidgetFrameBrush}"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Visibility="Collapsed">
            <Border.Resources>
                <Style TargetType="Slider">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" CornerRadius="2" Background="#45475A"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="#CCFFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="8,6"/>
                    <Setter Property="CaretBrush"      Value="#CDD6F4"/>
                    <Setter Property="SelectionBrush"  Value="#4489B4FA"/>
                </Style>
                <Style TargetType="Label">
                    <Setter Property="Foreground"  Value="#80FFFFFF"/>
                    <Setter Property="FontSize"    Value="11"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                    <Setter Property="Padding"     Value="0,0,0,4"/>
                </Style>
                <Style x:Key="FormPrimaryButton" TargetType="Button">
                    <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground"      Value="#1E1E2E"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="16,7"/>
                    <Setter Property="FontWeight"      Value="SemiBold"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#45475A"/>
                                        <Setter Property="Foreground" Value="#6C7086"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="FormGhostButton" TargetType="Button">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="#6C7086"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="16,7"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="FormDangerButton" TargetType="Button">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="#F38BA8"/>
                    <Setter Property="BorderBrush"     Value="#F38BA8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding"         Value="16,7"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3D1A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="FormToggleCheck" TargetType="CheckBox">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Width="36" Height="20" CornerRadius="10" Background="{TemplateBinding Background}">
                                    <Ellipse Width="16" Height="16" Fill="White" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="2,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Background" Value="#45475A"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Background"      Value="#1AFFFFFF"/>
                    <Setter Property="Foreground"      Value="#CCFFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="8,6"/>
                    <Setter Property="Cursor"          Value="Hand"/>
                    <Setter Property="MaxDropDownHeight" Value="200"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            <TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#80FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ToggleButton Focusable="false"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="Slide">
                                        <Border Background="#2A2A3E" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="8"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground"  Value="#CCFFFFFF"/>
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="Padding"     Value="8,5"/>
                                <Setter Property="Cursor"      Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="#1E1E2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>

            <StackPanel TextElement.FontFamily="Segoe UI" TextElement.FontSize="13" TextElement.Foreground="#CDD6F4">
                <Grid Margin="8,14,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FormTitleText" Grid.Column="0" Text="New Task" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource FormGhostButton}" Padding="8,4" Click="FormCancelBtn_Click"/>
                </Grid>
                <Rectangle Height="1" Fill="#30FFFFFF" Margin="8,10,8,0"/>
                <StackPanel Margin="8,12,8,12">
                    <Label Content="Task name *"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8">
                        <TextBox x:Name="FormNameBox" TextChanged="FormNameBox_TextChanged"/>
                    </Border>
                    <Label Content="Importance (1 = low, 100 = high) *" Margin="0,12,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FormImportanceSlider" Grid.Column="0" Minimum="1" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="FormImportanceSlider_ValueChanged"/>
                        <TextBlock x:Name="FormImportanceLabel" Grid.Column="1" Text="50" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Label Content="Description (optional)" Margin="0,12,0,0"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8" Height="80">
                        <TextBox x:Name="FormDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Top" TextChanged="FormPreview_Changed"/>
                    </Border>
                    <Label Content="URL (optional)" Margin="0,12,0,0"/>
                    <Border Background="#1AFFFFFF" CornerRadius="8" Height="34">
                        <TextBox x:Name="FormUrlBox" VerticalAlignment="Center" TextChanged="FormPreview_Changed"/>
                    </Border>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DEADLINE" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FormDeadlineEnabledBox" Grid.Column="1" Style="{StaticResource FormToggleCheck}" Checked="FormDeadlineEnabledBox_Changed" Unchecked="FormDeadlineEnabledBox_Changed"/>
                    </Grid>
                    <StackPanel x:Name="FormDeadlinePanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <!-- Date: inline label + calendar button -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FormDateInlineLabel"
                                           Grid.Column="0"
                                           Text="Date"
                                           Foreground="#80FFFFFF"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="FormDatePickerBtn"
                                        Grid.Column="1"
                                        Content="📅"
                                        Style="{StaticResource FormGhostButton}"
                                        Padding="6,4"
                                        Click="FormDatePickerBtn_Click"/>
                            </Grid>
                            <StackPanel Grid.Column="2">
                                <Label Content="Hour"/>
                                <ComboBox x:Name="FormDeadlineHourBox" SelectionChanged="FormPreview_Changed"/>
                            </StackPanel>
                        </Grid>
                        <!-- Calendar popup -->
                        <Popup x:Name="FormDatePopup"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#313244"
                                    BorderBrush="#50FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <Calendar x:Name="FormDeadlineCal"
                                          SelectionMode="SingleDate"
                                          SelectedDatesChanged="FormDeadlineCal_SelectedDatesChanged"/>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IMPORTANCE SCALING" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FormTickerEnabledBox" Grid.Column="1" Style="{StaticResource FormToggleCheck}" Checked="FormTickerEnabledBox_Changed" Unchecked="FormTickerEnabledBox_Changed"/>
                    </Grid>
                    <StackPanel x:Name="FormTickerPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Points per tick"/>
                                <Border Background="#1AFFFFFF" CornerRadius="8">
                                    <TextBox x:Name="FormTickerPointsBox" Text="1"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Hours per tick"/>
                                <Border Background="#1AFFFFFF" CornerRadius="8">
                                    <TextBox x:Name="FormTickerHoursBox" Text="1"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="FormAutoScaleBtn" Content="Auto from deadline" Style="{StaticResource FormGhostButton}" Padding="0,5" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Click="FormAutoScaleBtn_Click"/>
                    </StackPanel>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FormDeleteBtn" Grid.Column="0" Content="Delete Task" Style="{StaticResource FormDangerButton}" Visibility="Collapsed" Padding="8,7" Click="FormDeleteBtn_Click"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource FormGhostButton}" Padding="8,7" Click="FormCancelBtn_Click"/>
                            <Button x:Name="FormSaveBtn" Content="Add Task" Style="{StaticResource FormPrimaryButton}" IsEnabled="False" Padding="8,7" Margin="6,0,0,0" Click="FormSaveBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Add tab button: visible when form is closed -->
        <Button x:Name="AddTaskTabBtn"
                Grid.Column="0"
                Content="+"
                Style="{StaticResource TabBtn}"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="0,12,6,0"
                Click="AddTaskBtn_Click"/>

        <!-- Main rounded frame -->
        <Border Grid.Column="1"
                CornerRadius="24"
                Background="{DynamicResource WidgetFrameBrush}"
                Padding="0,12,0,12"
                VerticalAlignment="Top">
            <ScrollViewer x:Name="MainScroll"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,4,8,4">

                    <StackPanel x:Name="DoingSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Doing" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="DoingList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      DragOver="List_DragOver"
                                      Drop="List_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"
                                                   AllowDrop="True"
                                                   DragOver="Card_DragOver"
                                                   DragLeave="Card_DragLeave"
                                                   Drop="Card_Drop"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="OverdueSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#60E05A57" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Overdue" Foreground="#E05A57" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#60E05A57" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="OverdueList"
                                      Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="TodoSection">
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="To Do" Foreground="#80FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="8,0"/>
                            <Rectangle Grid.Column="2" Height="1" Fill="#40FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="TodoList"
                                      AllowDrop="True"
                                      Background="Transparent"
                                      DragOver="List_DragOver"
                                      Drop="List_Drop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"
                                                   AllowDrop="True"
                                                   DragOver="Card_DragOver"
                                                   DragLeave="Card_DragLeave"
                                                   Drop="Card_Drop"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="DoneSection">
                        <Button x:Name="DoneToggleBtn"
                                Style="{StaticResource CollapseBtn}"
                                Click="DoneToggleBtn_Click">
                            <TextBlock>
                                <Run x:Name="DoneChevron" Text="&#x25BE; "/>
                                <Run Text="Completed"/>
                            </TextBlock>
                        </Button>
                        <ItemsControl x:Name="DoneList" x:FieldModifier="private">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:TaskCard Task="{Binding}"
                                                   StatusSetRequested="Card_StatusSetRequested"
                                                   EditRequested="Card_EditRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── First-run welcome overlay (Google Drive sync) ────────────────── -->
        <Border x:Name="WelcomeOverlay"
                Grid.Column="1"
                CornerRadius="24"
                Background="#F01E1E2E"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Top"
                Padding="22,22,22,22"
                Visibility="Collapsed">
            <StackPanel TextElement.FontFamily="Segoe UI" TextElement.Foreground="#CDD6F4">
                <TextBlock Text="❤" FontSize="42" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Welcome to TASKly"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#A6ADC8"
                           TextAlignment="Center"
                           Margin="0,0,0,16">
                    Sign in to Google Drive to sync your tasks across all your devices.
                    A small <Run FontWeight="SemiBold">TASKly</Run> folder will be created in your Drive
                    and only this app can see it.
                </TextBlock>
                <Button x:Name="WelcomeSignInBtn"
                        Content="Sign in to Google Drive"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Stretch"
                        Padding="14,9"
                        Margin="0,0,0,8"
                        Click="WelcomeSignInBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="WelcomeSkipBtn"
                        Content="Use offline"
                        Background="Transparent"
                        Foreground="#6C7086"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Padding="14,7"
                        Click="WelcomeSkipBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="WelcomeStatusText"
                           Text=""
                           Foreground="#F38BA8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>